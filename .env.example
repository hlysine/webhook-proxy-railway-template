# ---------------------------------------------------------------------------
# Target: Hermes Agent webhook route (required)
# ---------------------------------------------------------------------------
# Full URL of the Hermes route that should receive the messages, e.g.
#   https://hermes-production.up.railway.app/webhooks/gmail
HERMES_WEBHOOK_URL=https://hermes-production.up.railway.app/webhooks/gmail

# HMAC secret configured on that Hermes route
# (platforms.webhook.extra.routes.<route>.secret). Must match exactly.
# Required unless HERMES_SIGNATURE_SCHEME=none.
HERMES_WEBHOOK_SECRET=replac…cret

# Signing scheme Hermes expects: v2 | standard | github | none
#   v2       -> X-Webhook-Signature-V2 + X-Webhook-Timestamp (Hermes "Generic V2", recommended)
#   standard -> webhook-id / webhook-timestamp / webhook-signature (Standard Webhooks)
#   github   -> X-Hub-Signature-256
#   none     -> no signature headers; local testing only
HERMES_SIGNATURE_SCHEME=v2

# Optional route name, used for logging and as an extra accepted push path
# (POST /<route>). Defaults to the last path segment of HERMES_WEBHOOK_URL.
# HERMES_ROUTE=gmail

# decoded -> unwrap message.data from base64, parse JSON, attach "_pubsub" metadata
# raw     -> forward the original Pub/Sub push envelope verbatim
FORWARD_MODE=decoded

# Timeout for the request to Hermes, in milliseconds.
HERMES_TIMEOUT_MS=8000

# When false (default) a non-retryable Hermes 4xx is logged and acknowledged with
# 204 so a misconfigured route cannot create an infinite Pub/Sub retry loop.
# When true every Hermes failure returns 503 and Pub/Sub redelivers.
RETRY_ON_4XX=false

# ---------------------------------------------------------------------------
# Source: Google Cloud Pub/Sub push subscription
# ---------------------------------------------------------------------------
PUBSUB_PROJECT=hermes-agent-1234
PUBSUB_SUBSCRIPTION=hermes

# Service account that Pub/Sub signs push JWTs with
# (--push-auth-service-account).
PUBSUB_SERVICE_ACCOUNT_EMAIL=hermes-agent@hermes-agent-1234.iam.gserviceaccount.com

# Comma-separated accepted JWT "aud" values. Leave unset to accept this service's
# own public URL / Host header automatically. Set it explicitly if the
# subscription was created with --push-auth-token-audience.
# PUBSUB_AUDIENCE=https://webhook-proxy.up.railway.app

# Reject tokens whose iat is older than this. Pub/Sub documents that push tokens
# may be up to one hour old.
JWT_MAX_AGE_SECONDS=3600

# Clock-skew tolerance in seconds applied to exp/iat.
JWT_SKEW_SECONDS=60

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Railway injects PORT at runtime; the value below is only for local runs.
PORT=8080
HOSTNAME=0.0.0.0
LOG_LEVEL=info

# Public origin of this proxy, used as a default JWT audience candidate.
# PUBLIC_URL=https://webhook-proxy.up.railway.app

# Maximum accepted push body in bytes.
MAX_BODY_BYTES=5242880

# Local testing only: skip JWT validation. Refuses to start unless HOSTNAME is a
# loopback address, so it can never take effect on Railway.
# INSECURE_SKIP_JWT=true
